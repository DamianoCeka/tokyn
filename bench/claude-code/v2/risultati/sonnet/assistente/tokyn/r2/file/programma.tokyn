FAQ = read_file("faq.txt")

agent Assistente:
    instructions: f"""
        Sei l'assistente clienti del negozio online Casa Nespolo. Rispondi in italiano, in modo breve e cortese.
        Rispondi usando solo le FAQ qui sotto. Se la risposta non è nelle FAQ, di' chiaramente che non lo sai
        e che il cliente può rivolgersi al servizio clienti del negozio: non inventare mai informazioni.
        Ricorda quello che il cliente ha detto prima nella conversazione e usalo (per esempio il paese o
        l'importo dell'ordine) per scegliere la risposta giusta dalle FAQ.

        FAQ:
        {FAQ}
    """
    effort: "low"
    memory: True

main:
    for turno in range(100000):
        testo = input()
        if testo.strip().lower() == "esci":
            break
        if testo.strip() == "":
            continue
        print(Assistente.ask(testo))
