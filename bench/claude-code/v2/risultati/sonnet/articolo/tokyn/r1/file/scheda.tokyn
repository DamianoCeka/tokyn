type Scheda:
    titolo: str "titolo breve, una riga, senza punto finale"
    punti: list[str] "i cinque punti chiave dell'articolo, esattamente cinque, una frase ciascuno"
    citati: list[str] "nomi di persone e organizzazioni citate nell'articolo, ognuno una sola volta, senza ruoli"

agent Redattore:
    instructions: """
        Leggi l'articolo di giornale e prepara una scheda in italiano: un titolo breve, esattamente cinque punti
        chiave (una frase ciascuno) e l'elenco delle persone e delle organizzazioni citate nell'articolo,
        ognuna una sola volta, con il nome proprio come compare nel testo (senza ruolo o titolo).
    """
    output: Scheda
    effort: "low"

main:
    testo = read_file("articolo.txt")
    scheda = Redattore.ask(testo)
    for tentativo in range(3):
        if len(scheda.punti) == 5:
            break
        scheda = Redattore.ask(testo + "\n\nATTENZIONE: servono esattamente 5 punti chiave.")
    punti = scheda.punti[:5]
    citati = []
    for nome in scheda.citati:
        nome = nome.strip()
        if nome != "" and nome not in citati:
            citati.append(nome)
    scheda.punti = punti
    scheda.citati = citati
    write_file("risultato.json", json_dump(scheda))
    print("Scritto risultato.json")
