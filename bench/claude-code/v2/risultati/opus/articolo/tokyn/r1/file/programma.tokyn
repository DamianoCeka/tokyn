type Scheda:
    titolo: str "titolo breve dell'articolo, in italiano"
    punti: list[str] "esattamente cinque punti chiave, una frase ciascuno"
    citati: list[str] "nomi delle persone e delle organizzazioni citate nell'articolo, ognuno una volta sola"

agent Redattore:
    instructions: """
        Prepari schede di articoli di giornale per i colleghi, in italiano.
        Dato il testo di un articolo restituisci:
        - un titolo breve;
        - esattamente cinque punti chiave, ognuno una sola frase che termina con il punto;
        - i nomi di tutte le persone e le organizzazioni citate, ciascuno una volta sola,
          con il nome completo come compare nell'articolo (niente ruoli o titoli).
    """
    output: Scheda
    effort: "low"

main:
    articolo = read_file("articolo.txt")
    scheda = Redattore.ask(articolo)
    for tentativo in range(2):
        if len(scheda.punti) == 5:
            break
        scheda = Redattore.ask(f"Servono esattamente cinque punti chiave, non {len(scheda.punti)}.\n\n{articolo}")
    if len(scheda.punti) != 5:
        print(f"Errore: l'IA ha restituito {len(scheda.punti)} punti invece di cinque.")
        return
    citati = []
    visti = []
    for nome in scheda.citati:
        nome = nome.strip()
        if nome != "" and nome.lower() not in visti:
            visti.append(nome.lower())
            citati.append(nome)
    scheda.citati = citati
    write_file("risultato.json", json_dump(scheda))
    print(json_dump(scheda))
