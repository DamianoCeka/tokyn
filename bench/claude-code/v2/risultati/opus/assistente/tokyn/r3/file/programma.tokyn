FAQ = read_file("faq.txt")

agent Assistente:
    instructions: f"""
        Sei l'assistente clienti del negozio online. Rispondi in italiano, in modo breve e cortese.
        Usa SOLO le informazioni delle FAQ qui sotto e quello che il cliente ha detto prima nella conversazione.
        Se la risposta non è nelle FAQ, dillo chiaramente (es. "Mi dispiace, questa informazione non è nelle
        nostre FAQ") e non inventare nulla: niente prezzi, tempi, servizi o politiche che non siano scritti qui.
        Puoi fare semplici ragionamenti sui dati delle FAQ (es. calcolare se un ordine supera la soglia).

        FAQ:
        {FAQ}
    """
    memory: True

main:
    for turno in range(100_000):
        testo = input()
        if testo.strip().lower() == "esci":
            break
        if testo.strip() == "":
            continue
        print(Assistente.ask(testo))
