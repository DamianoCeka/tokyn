type Analisi:
    sentimento: "positivo" | "negativo" | "neutro"
    voto: int "voto da 1 a 5 che il cliente darebbe al prodotto"

agent Analista:
    model: "claude-haiku"
    effort: "low"
    instructions: "Analizzi una recensione di un prodotto: indica il sentimento e il voto da 1 a 5."
    output: Analisi

main:
    recensioni = []
    for riga in read_file("recensioni.txt").splitlines():
        testo = riga.strip()
        if testo != "":
            a = Analista.ask(testo)
            voto = min(max(a.voto, 1), 5)
            recensioni.append({"testo": testo, "sentimento": a.sentimento, "voto": voto})
    media = 0
    if len(recensioni) > 0:
        totale = 0
        for r in recensioni:
            totale += r["voto"]
        media = round(totale / len(recensioni), 2)
    write_file("risultato.json", json_dump({"recensioni": recensioni, "media": media}))
    print(f"Analizzate {len(recensioni)} recensioni, voto medio {media}")
